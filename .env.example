# Copy to .env and fill in. .env is gitignored.

# Resend API key (https://resend.com/api-keys). Leave empty in development to
# print emails (verification codes, alerts) to the server console instead.
RESEND_API_KEY=

# Sender for all emails. Must be on a domain verified in Resend. Without it,
# Resend's shared test sender is used, which only delivers to your own
# Resend account email.
EMAIL_FROM="OneVault <security@yourdomain.com>"

# Public URL of the app, used for links in emails.
APP_URL=http://localhost:3000
