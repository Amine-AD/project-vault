# Copy to .env and fill in. .env is gitignored.

# Resend API key (https://resend.com/api-keys). Leave empty in development to
# print emails (verification codes, alerts) to the server console instead.
RESEND_API_KEY=

# Sender for all emails. Must be on a domain verified in Resend. Without it,
# Resend's shared test sender is used, which only delivers to your own
# Resend account email.
EMAIL_FROM="OneVault <security@yourdomain.com>"

# Public URL of the app, used for links in emails.
APP_URL=http://localhost:3000

# Optional. Where the database file lives. Defaults to vault.db in the folder
# the server is started from. With Docker, point it at a volume, e.g.
# /data/vault.db. Back up this file (with its -wal file): it holds every
# account and encrypted vault.
DATABASE_PATH=

# Optional. Server secret (32+ characters) for keyed hashes, e.g. the stand-in
# salts that hide which emails have a vault. Leave empty to have one generated
# and stored in vault.db on first run. Set it if several servers share one
# database. Generate one with: openssl rand -base64 32
APP_SECRET=

# Set if OneVault runs behind a reverse proxy (Caddy, nginx, Traefik, a load
# balancer): 1 for one proxy, or the number of proxies in the chain (e.g. 2
# for Cloudflare in front of nginx). Only then are the X-Forwarded-For and
# X-Forwarded-Proto headers believed. Leave empty when browsers connect to
# OneVault directly: otherwise anyone could fake their IP address and get
# around the rate limits on sign-in attempts and email codes.
TRUST_PROXY=

# Busy hosted servers: password checks run on Node's worker thread pool (4
# threads by default), which file reads also use. If static files feel slow
# during sign-in spikes, set UV_THREADPOOL_SIZE=8 in the real environment
# (Docker, systemd). It has no effect when set in this file.
